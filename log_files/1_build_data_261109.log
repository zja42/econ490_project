> 2 < `measure'_min | missing(`measure'_min))
 10.     generate `measure'_max = `measure'_option1
 11.     replace `measure'_max = `measure'_option2 if !missing(`measure'_option2) & (`measure'_option
> 2 > `measure'_max | missing(`measure'_max))
 12.     generate `measure'_n = !missing(`measure'_option1) + !missing(`measure'_option2)
 13.     generate known_`measure' = `measure'_n>0 & `measure'_min>=0
 14.     generate same_`measure' = `measure'_n==L1.`measure'_n & abs(`measure'_min-L1.`measure'_min)<
> =0.1 & abs(`measure'_max-L1.`measure'_max)<=0.1
 15.     generate nondecrease_`measure' = same_`measure' | `measure'_min>=L1.`measure'_max-0.1
 16.     generate increase_`measure' = `measure'_min>L1.`measure'_max+0.1
 17. }
