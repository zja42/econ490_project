. * Build one analysis file per sample
. foreach s in europe oecd {
  2. 
.     use "${datadir_final}/`s'_twfe.dta", clear
  3.     xtset country_id year, yearly
  4. 
.     * PF2.1 Total_Father_specific_paid; slash cells keep the lower bound
.     generate fatherweeks = real(total_paid_raw)
  5.     recast double fatherweeks
  6.     replace fatherweeks = real(total_paid_raw)
  7.     replace fatherweeks = 28.6  if total_paid_raw == "28.6 / 54.6"
  8.     replace fatherweeks = 30.17 if total_paid_raw == "30.17 / 56.17"
  9.     label variable fatherweeks "Weeks of paid father-specific leave (PF2.1, lower bound)"
 10. 
.     * Unit: pp change in the gap per 10 extra weeks of lagged leave
.     generate fatherweeks10 = fatherweeks/10
 11.     label variable fatherweeks10 "Father-specific paid leave, per 10 weeks"
 12.     if "`s'" == "oecd" {
 13.         * Keep employment rows and attach the policy lag, including across employment gaps.
.         merge 1:1 iso year using `oecd_policy_lag'
 14.         drop if _merge==2
 15.         drop _merge
 16.         generate lag_fatherweeks10 = policy_lag_weeks10
 17.         drop policy_lag_weeks10
 18.     }
 19.     else {
 20.         generate lag_fatherweeks10 = L1.fatherweeks10
 21.     }
 22.     label variable lag_fatherweeks10 "Lagged father-specific paid leave, per 10 weeks"
 23. 
.     * WDI macro controls, with lags already built on the full annual series
.     sort iso year
 24.     merge 1:1 iso year using "${datadir_final}/wdi_controls.dta"
 25.     keep if _merge==3
 26.     drop _merge
 27. 
.     * Public leave spending; maternal_weeks kept for inspection only (sparse coverage)
.     sort iso year
 28.     merge 1:1 iso year using "${datadir_final}/policy_controls.dta"
 29.     keep if _merge==3
 30.     drop _merge
 31. 
.     * Lagged log GDP per capita is required in every regression
.     label variable leave_gdp "Public maternity and parental leave spending, percent of GDP"
 32. 
.     * post: years at/after the first verified expansion; controls have no reform year
.     generate post = (year>=reform_year) if !missing(reform_year)
 33.     replace post = 0 if missing(post)
 34.     label variable post "Post first verified expansion of reserved paid leave"
 35. 
.     * Coverage of the control variables
.     * Non-missing paid maternity weeks
.     count if maternal_weeks!=.
 36.     * Non-missing lagged log GDP per capita
.     count if lag_lngdp!=.
 37.     * Non-missing public leave spending
.     count if leave_gdp!=.
 38. 
.     save "${datadir_final}/`s'_analysis_261109.dta", replace
 39. }

